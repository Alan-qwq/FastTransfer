<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 局域网传输所需 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      读取待发送文件 / 写入收到的文件。

      ★ 不要声明 READ_MEDIA_IMAGES / VIDEO / AUDIO ★
      那三个是「按类型的媒体读取」权限，只能读媒体文件，**无法遍历目录树**。
      内置文件浏览器靠 File.listFiles() 浏览，在 Android 13+ 上弹的却是
      「允许访问照片和视频？」，用户点了允许依然什么都看不到 —— 等于给了个假权限。
      有了 MANAGE_EXTERNAL_STORAGE（所有文件访问）就完全不需要它们。

      WRITE 的上限是 29 而不是 28：Android 10 配 requestLegacyExternalStorage
      走的是旧存储模型，**仍然需要写权限**；限成 28 会让 Android 10 写不进去。
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!--
      内置文件浏览器需要遍历目录树。Android 11+ 分区存储会把 File.listFiles()
      挡住，只能靠这个权限；Android 10 及以下用不到。
      注意：这个权限在 Google Play 上需要单独申请（仅文件管理器类应用可获批），
      本应用按侧载用途声明；若上架 Play 请移除本权限，改用 SAF。
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- 扫码连接（相机为可选硬件，没有摄像头的词典笔/手表也能安装） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />

    <!-- 前台服务：保持接收可见（Android 14+ 必须声明类型） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 屏幕兼容性：手机 / 平板 / 手表 / 词典笔（小屏、无触摸以外的特殊要求） -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <application
        android:name=".FastTransferApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:preserveLegacyExternalStorage="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FastTransfer"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FastTransfer">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 接收其他应用分享的文件 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.FileBrowserActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="false"
            android:label="@string/file_browser_title" />

        <activity
            android:name=".ui.ScanActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="false"
            android:label="@string/scan_title"
            android:theme="@style/Theme.FastTransfer.Scan" />

        <activity
            android:name=".ui.QrDisplayActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density"
            android:exported="false"
            android:label="@string/qr_card_title" />

        <service
            android:name=".core.TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
