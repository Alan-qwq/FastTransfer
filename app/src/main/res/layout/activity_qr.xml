<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/space_xl">

    <TextView
        style="@style/Text.TitleLarge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/qr_card_title"
        android:textColor="@android:color/white" />

    <ImageView
        android:id="@+id/iv_qr_large"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_weight="1"
        android:background="@android:color/white"
        android:contentDescription="@string/qr_card_title"
        android:padding="@dimen/space_md"
        android:scaleType="fitCenter" />

    <TextView
        android:id="@+id/tv_qr_large_address"
        style="@style/Text.TitleMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center"
        android:textColor="@android:color/white" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_qr_large_close"
        style="@style/Widget.FastTransfer.Button.Tonal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:text="@string/action_close"
        app:icon="@drawable/ic_close"
        app:iconGravity="textStart"
        app:iconPadding="@dimen/space_sm" />
</LinearLayout>
