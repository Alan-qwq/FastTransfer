<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingLeft="@dimen/space_lg"
    android:paddingRight="@dimen/space_lg"
    android:paddingBottom="@dimen/space_xxl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== 本机信息卡（M3 filled card） ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_local"
            style="@style/Widget.FastTransfer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:clickable="true"
            android:contentDescription="@string/a11y_local_device_card"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/space_lg">

                <FrameLayout
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:layout_marginRight="@dimen/space_md">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_avatar_primary_container" />

                    <ImageView
                        android:layout_width="@dimen/icon_size_lg"
                        android:layout_height="@dimen/icon_size_lg"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dev_phone"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_local_alias"
                        style="@style/Text.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/local_device_unnamed" />

                    <TextView
                        android:id="@+id/tv_local_address"
                        style="@style/Text.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/local_ip_unknown" />

                    <TextView
                        android:id="@+id/tv_local_visibility"
                        style="@style/Text.LabelMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xxs"
                        android:text="@string/visibility_on"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btn_rename"
                    style="@style/Widget.FastTransfer.IconButton"
                    android:contentDescription="@string/edit_device_name"
                    android:src="@drawable/ic_edit" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 模式切换（M3 分段按钮） ===== -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/toggle_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_md"
            app:checkedButton="@id/btn_mode_text"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_text"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/button_height"
                android:text="@string/send_mode_text"
                app:icon="@drawable/ic_text"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_sm" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mode_file"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="@dimen/button_height"
                android:text="@string/send_mode_file"
                app:icon="@drawable/ic_folder"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/space_sm" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ===== 文字输入卡 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_text"
            style="@style/Widget.FastTransfer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_message"
                    style="@style/Widget.FastTransfer.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/send_text_hint"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:counterEnabled="true"
                    app:counterMaxLength="2000"
                    app:counterOverflowTextAppearance="@style/Text.LabelMedium">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="8"
                        android:minHeight="@dimen/text_input_min_height"
                        android:textSize="@dimen/text_body_large" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send_all"
                        style="@style/Widget.FastTransfer.Button.Text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start|center_vertical"
                        android:text="@string/broadcast_to_all" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_send_text"
                        style="@style/Widget.FastTransfer.Button.Filled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="104dp"
                        android:text="@string/action_send"
                        app:icon="@drawable/ic_send"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_sm" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 文件卡 ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_files"
            style="@style/Widget.FastTransfer.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_files_summary"
                        style="@style/Text.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/send_need_files" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_clear_files"
                        style="@style/Widget.FastTransfer.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/clear_selection"
                        android:visibility="gone" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_selected_files"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_xs"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_pick_files"
                        style="@style/Widget.FastTransfer.Button.Tonal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/space_sm"
                        android:layout_weight="1"
                        android:text="@string/action_add_files"
                        app:icon="@drawable/ic_attach"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_sm" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_browse_files"
                        style="@style/Widget.FastTransfer.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/file_browser_title"
                        app:icon="@drawable/ic_folder"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/space_sm" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_files"
                    style="@style/Widget.FastTransfer.Button.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/action_send"
                    app:icon="@drawable/ic_send"
                    app:iconGravity="textStart"
                    app:iconPadding="@dimen/space_sm" />

                <!-- 群发原先只在文字模式有，文件模式想群发就没有入口 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_send_all_files"
                    style="@style/Widget.FastTransfer.Button.Outlined"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_sm"
                    android:text="@string/broadcast_to_all" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== 设备列表 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_device_section"
                style="@style/Text.SectionTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/send_no_device" />

            <!--
              连接方式和「刷新」放在同一行，**始终可见**。
              原先它们藏在「空状态」里，一旦扫到了设备就再也找不到入口，
              想手动连另一台机器只能先去清空列表。
            -->
            <ImageView
                android:id="@+id/btn_scan_connect"
                style="@style/Widget.FastTransfer.IconButton"
                android:contentDescription="@string/action_scan_connect"
                android:src="@drawable/ic_qr_scan"
                app:tint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/btn_manual_connect"
                style="@style/Widget.FastTransfer.IconButton"
                android:contentDescription="@string/action_connect_by_ip"
                android:src="@drawable/ic_link"
                app:tint="?attr/colorPrimary" />

            <ImageView
                android:id="@+id/btn_refresh"
                style="@style/Widget.FastTransfer.IconButton"
                android:contentDescription="@string/action_refresh"
                android:src="@drawable/ic_refresh"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_devices"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <!-- ===== 空状态 ===== -->
        <LinearLayout
            android:id="@+id/ll_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/space_xl"
            android:paddingBottom="@dimen/space_xl">

            <FrameLayout
                android:layout_width="@dimen/empty_state_badge"
                android:layout_height="@dimen/empty_state_badge">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_avatar_surface_variant" />

                <ImageView
                    android:layout_width="@dimen/icon_size_lg"
                    android:layout_height="@dimen/icon_size_lg"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_radar"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </FrameLayout>

            <TextView
                android:id="@+id/tv_empty_title"
                style="@style/Text.TitleMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/send_scanning" />

            <TextView
                android:id="@+id/tv_empty_hint"
                style="@style/Text.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/send_no_device_hint" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
