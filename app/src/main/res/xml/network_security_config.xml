<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 局域网直连使用明文 HTTP（与 LocalSend 的 HTTP 模式一致） -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
